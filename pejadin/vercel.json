{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "app": {
        "root": ".",
        "runtime": "python",
        "entrypoint": "app.py"
      },
      "backend": {
        "root": "backend",
        "framework": "fastapi"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "app"
        }
      }
    ]
  }
